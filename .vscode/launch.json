{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "IOBootstrap.Net.Default.Application",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "buildIOBootstrapNetDefaultApplication",
            "program": "${workspaceFolder}/Default/Application/bin/Debug/net8.0/IOBootstrap.NET.Default.Application.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Default/Application",
            "stopAtEntry": false,
            "checkForDevCert": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "^\\s*Now listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5000;https://localhost:5001",
                "IO_ENCRYPTION_KEY": "test1234",
                "IO_ENCRYPTION_IV": "test1234"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Backoffice.UI (run backoffice)",
            "request": "launch",
            "cwd": "${workspaceFolder}/Application/Backoffice.UI",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "Backoffice.UI (Chrome Vite)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000/backoffice/",
            "webRoot": "${workspaceFolder}/Backoffice.UI/src"
        },
        {
            "name": "Web.UI (run web)",
            "request": "launch",
            "cwd": "${workspaceFolder}/Web.UI",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "name": "Web.UI (Chrome Vite)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3001/ui/",
            "webRoot": "${workspaceFolder}/Backoffice.UI/src"
        },
        {
            "name": "IOBootstrapNetApplicationPublish",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "publishIOBootstrapNetApplication",
            "program": "${workspaceFolder}/Application/bin/Debug/netcoreapp3.1/IOBootstrap.NET.Application.dll",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Release",
                "ASPNETCORE_URLS": "http://localhost:5000"
            }
        },
        {
            "name": "Attach to .NET Functions",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:azureFunctions.pickProcess}"
        },
        {
            "name": "Build IOBootstrapt CLI Tool",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "program": "${workspaceFolder}/CLI/build/__debug_bin",
            "cwd": "${workspaceFolder}/CLI/build",
            "console": "integratedTerminal",
            "preLaunchTask": "buildIOBootstraptCLIBuild",
            "args": [
                "-netenv",
                "Staging",
                "-reactenv",
                "staging",
                "-sln",
                "${workspaceFolder}",
                "-reactui",
                "${workspaceFolder}/React.UI",
                "-backoffice",
                "${workspaceFolder}/Backoffice.UI",
                "-www-bo-output-dir-name",
                "backoffice",
                "-docker-working-dir",
                "${workspaceFolder}/API-Files/Docker",
                "-docker-build-dir-name",
                "Staging",
                "-docker-port",
                "5003",
                "-docker-image-name",
                "iobootstrap-net",
                "-docker-template-file",
                "${workspaceFolder}/Docker/Dockerfile.arm64.ft",
                "-docker",
                "${workspaceFolder}/API-Files/Staging"
            ]
        },
        {
            "name": "IOBootstrap.Net.Default.Batch",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "buildIOBootstrapNetBatch",
            "program": "${workspaceFolder}/Default/Batch/bin/Debug/net8.0/IOBootstrap.Net.Default.Batch.dll",
            "args": ["Development"],
            "cwd": "${workspaceFolder}/Default/Batch",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "IO_ENCRYPTION_KEY": "test1234",
                "IO_ENCRYPTION_IV": "test1234"
            }
        },
        {
            "name": "IO.DB.Migration",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet ef migrations add ${input:ioMigrationName} --project \"${workspaceFolder}/MobileAppBetaDistributions/Application/MobileAppBetaDistributions.Application.csproj\" --startup-project \"${workspaceFolder}/MobileAppBetaDistributions/Application/MobileAppBetaDistributions.Application.csproj\"",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "IO_ENCRYPTION_KEY": "test1234",
                "IO_ENCRYPTION_IV": "test1234"
            }
        },
        {
            "name": "AppCell.DB.Script",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet ef migrations script ${input:ioMigrationFrom} ${input:ioMigrationName} --project \"${workspaceFolder}/MobileAppBetaDistributions/Application/MobileAppBetaDistributions.Application.csproj\" --startup-project \"${workspaceFolder}/MobileAppBetaDistributions/Application/MobileAppBetaDistributions.Application.csproj\"",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "IO_ENCRYPTION_KEY": "test1234",
                "IO_ENCRYPTION_IV": "test1234"
            }
        },
        {
            "name": "Build.Components",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/IOBootstrap-NET/React.UI",
            "command": "npm install && npm run build:development"
        },
    ],
    "compounds": [
        {
            "name": "Backoffice.UI (Dev + Chrome) (debug on chrome)",
            "configurations": [
                "Backoffice.UI (run backoffice)",
                "Backoffice.UI (Chrome Vite)"
            ]
        },
        {
            "name": "Web.UI (Dev + Chrome) (debug on chrome)",
            "configurations": [
                "Web.UI (run web)",
                "Web.UI (Chrome Vite)"
            ]
        }
    ],
    "inputs": [
        {
            "id": "ioMigrationFrom",
            "type": "promptString",
            "description": "Migration from",
            "default": ""
        },
        {
            "id": "ioMigrationName",
            "type": "promptString",
            "description": "Migration name",
            "default": ""
        }
    ]
}

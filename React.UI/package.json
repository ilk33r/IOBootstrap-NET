{
    "name": "build-iobootstrap-ui",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "modules/*"
    ],
    "scripts": {
        "build:development": "lerna run build:development --include-dependencies",
        "build:staging": "lerna run build:staging --include-dependencies",
        "build:production": "lerna run build:production --include-dependencies",
        "build": "lerna run build --include-dependencies",
        "clean": "lerna run clean",
        "watch": "lerna run watch",
        "package": "lerna exec -- npm pack"
    },
    "dependencies": {
        "@rollup/plugin-commonjs": "^25.0.7",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "lerna": "^9.0.3",
        "rollup": "^4.53.3",
        "rollup-plugin-postcss": "^4.0.2",
        "rollup-plugin-typescript2": "^0.36.0"
    },
    "devDependencies": {
        "@rollup/plugin-typescript": "^12.3.0",
        "typescript": "^5.9.3"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.18.0"
    }
}

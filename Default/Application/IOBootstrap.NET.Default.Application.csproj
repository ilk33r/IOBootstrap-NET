<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\WebApi\IOBootstrap.NET.WebApi.csproj" />
    <ProjectReference Include="..\..\BackOffice\IOBootstrap.NET.BackOffice.csproj" />
    <ProjectReference Include="..\..\Application\IOBootstrap.NET.Application.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>NETCORE_10_0</DefineConstants>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- <PackageReference Include="MySql.EntityFrameworkCore" Version="9.0.0" /> -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <DefineConstants>USE_POSTGRES_DATABASE;PLAIN_CONNECTION_STRING;DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <NoStdLib>false</NoStdLib>
    <DefineConstants>USE_POSTGRES_DATABASE;RELEASE</DefineConstants>
  </PropertyGroup>
  
  <ItemGroup>
    <Content Include="BOTemplates\**" LinkBase="BOTemplates">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory> 
    </Content>
    <Content Include="io.service.sh" LinkBase="appcell.service.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory> 
    </Content>
    <Content Include="io.service.staging.sh" LinkBase="appcell.service.staging.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory> 
    </Content>
    <Content Include="localhost.pfx" LinkBase="localhost.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory> 
    </Content>
    <Content Include="Fonts\**" LinkBase="Fonts">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory> 
    </Content>
    <None Include="Backoffice.UI\**" LinkBase="Backoffice.UI" />
  </ItemGroup>

  <PropertyGroup>
    <SwaggerUiDebugJsSource>DevAssets\swagger-ui\swagger-encryption.js</SwaggerUiDebugJsSource>
    <SwaggerUiDebugJsTarget>wwwroot\swagger-ui\swagger-encryption.js</SwaggerUiDebugJsTarget>

    <SwaggerUiDebugJsInterceptorSource>DevAssets\swagger-ui\swagger-encryption-interceptor.js</SwaggerUiDebugJsInterceptorSource>
    <SwaggerUiDebugJsInterceptorTarget>wwwroot\swagger-ui\swagger-encryption-interceptor.js</SwaggerUiDebugJsInterceptorTarget>
  </PropertyGroup>

  <Target Name="CopySwaggerDebugAssets" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MakeDir Directories="wwwroot\swagger-ui" />
    <Copy SourceFiles="$(SwaggerUiDebugJsSource)" DestinationFiles="$(SwaggerUiDebugJsTarget)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(SwaggerUiDebugJsInterceptorSource)" DestinationFiles="$(SwaggerUiDebugJsInterceptorTarget)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySwaggerDebugAssets" BeforeTargets="Build" Condition="'$(Configuration)' == 'Staging'">
    <MakeDir Directories="wwwroot\swagger-ui" />
    <Copy SourceFiles="$(SwaggerUiDebugJsSource)" DestinationFiles="$(SwaggerUiDebugJsTarget)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(SwaggerUiDebugJsInterceptorSource)" DestinationFiles="$(SwaggerUiDebugJsInterceptorTarget)" SkipUnchangedFiles="true" />
  </Target>

  <!--
  <Target Name="RemoveSwaggerDebugAssets" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Delete Files="$(SwaggerUiDebugJsTarget)" />
    <Delete Files="$(SwaggerUiDebugJsInterceptorTarget)" />
  </Target>
  -->

  <PropertyGroup>
   <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
  </PropertyGroup>

</Project>
